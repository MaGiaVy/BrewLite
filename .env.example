# ---------- Cấu hình Môi trường Docker Compose (As1 - BrewLite_SWE) ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=brewlite
DB_PORT=5433

# Backend API (NestJS)
PORT=3001
# Bắt buộc đổi sang chuỗi bí mật ngẫu nhiên mạnh (>= 32 ký tự) trước khi chạy Docker/Production
JWT_SECRET=change-me-to-a-random-64-char-hex-secret
ALLOW_SANDBOX_CONFIRM=false
WEB_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ZaloPay Sandbox Integration (điền thông tin sandbox của bạn vào .env thực tế)
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_CREATE_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_QUERY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/query
ZALOPAY_CALLBACK_URL=http://localhost:3001/payments/zalopay/callback

# Frontend Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_PORT=3000
